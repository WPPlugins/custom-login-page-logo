#. Plugin Name of the plugin
#: custom_login_page_logo.php
msgid "Custom Login Page Logo"
msgstr "कस्टम लॉगिन पृष्ठ लोगो"

#. Plugin URI of the plugin
#: custom_login_page_logo.php
msgid "https://wordpress.org/plugins/custom-login-page-logo"
msgstr "https://wordpress.org/plugins/custom-login-page-logo"

#. Description of the plugin
#: custom_login_page_logo.php
msgid "Allows users to customize the logo on the WordPress login page."
msgstr "उपयोगकर्ताओं को वर्डप्रेस लॉगिन पृष्ठ पर लोगो को अनुकूलित करने की अनुमति देता है।"

#. Author of the plugin
#: custom_login_page_logo.php
msgid "Horendra Pal Singh Kandari"
msgstr "होरेन्द्र पाल सिंह कंडारी"

#: clpl-admin-menu.php:10
msgid "Custom Login Page Logo Settings"
msgstr "कस्टम लॉगिन पृष्ठ लोगो सेटिंग्स"

#: clpl-admin-menu.php:32
msgid "Custom Login Logo"
msgstr "कस्टम लॉगिन लोगो"

#: clpl-admin-menu.php:33
msgid "Login Logo"
msgstr "लॉगिन लोगो"

#: clpl-settings-fields.php:18
msgid "Upload Logo"
msgstr "लोगो अपलोड करें"

#: clpl-settings-fields.php:21
msgid "Upload image or enter a custom URL with http or https"
msgstr "छवि अपलोड करें या http या https के साथ कस्टम URL दर्ज करें"

#: clpl-settings-fields.php:43
msgid "Enter logo width"
msgstr "लोगो की चौड़ाई दर्ज करें"

#: clpl-settings-fields.php:60
msgid "Choose the measurement unit for logo width"
msgstr "लोगो की चौड़ाई के लिए माप की इकाई चुनें"

#: clpl-settings-fields.php:75
msgid "Enter logo height"
msgstr "लोगो की ऊंचाई दर्ज करें"

#: clpl-settings-fields.php:92
msgid "Choose the measurement unit for logo height"
msgstr "लोगो की ऊंचाई के लिए माप की इकाई चुनें"

#: clpl-settings-fields.php:112
msgid "Example: https://mydomain.com or http://mydomain.com"
msgstr "उदाहरण: https://mydomain.com या http://mydomain.com"

#: clpl-settings-fields.php:124
msgid "Yes"
msgstr "हाँ"

#: clpl-settings-fields.php:127
msgid "Select if you want logo shadow"
msgstr "यदि आप लोगो छाया चाहते हैं तो चुनें"

#: clpl-settings-fields.php:133
msgid "(Upload or select a custom logo for the login page.)"
msgstr "(लॉगिन पृष्ठ के लिए कस्टम लोगो अपलोड करें या चुनें.)"

#: clpl-settings-fields.php:142
msgid "Custom Login Logo Settings"
msgstr "कस्टम लॉगिन लोगो सेटिंग्स"

#: clpl-settings-fields.php:150
msgid "Custom Logo URL"
msgstr "कस्टम लोगो यूआरएल"

#: clpl-settings-fields.php:158
msgid "Custom Logo Width"
msgstr "कस्टम लोगो की चौड़ाई"

#: clpl-settings-fields.php:166
msgid "Custom Logo Width Unit"
msgstr "कस्टम लोगो चौड़ाई इकाई"

#: clpl-settings-fields.php:174
msgid "Custom Logo Height"
msgstr "कस्टम लोगो की ऊंचाई"

#: clpl-settings-fields.php:181
msgid "Custom Logo Height Unit"
msgstr "कस्टम लोगो ऊंचाई इकाई"

#: clpl-settings-fields.php:189
msgid "Custom Logo Redirect URL"
msgstr "कस्टम लोगो रीडायरेक्ट URL"

#: clpl-settings-fields.php:197
msgid "Custom Logo Shadow"
msgstr "कस्टम लोगो की छाया"

#: functions.php:45
msgid "Choose or Upload a Logo"
msgstr "लोगो चुनें या अपलोड करें"

#: functions.php:46
msgid "Use this Logo"
msgstr "इस लोगो का उपयोग करें"
